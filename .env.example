# Telegram bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Telegram user_id владельца бота.
# Узнать можно через специальных ботов или временно вывести message.from_user.id в /start.
OWNER_ID=123456789

# SQLite database path.
# Для локального запуска можно оставить ./data/bot.sqlite3
# Для Docker обычно используется /data/bot.sqlite3
DB_PATH=./data/bot.sqlite3

# Время жизни кеша проверки пользователя, в минутах
CACHE_TTL_MINUTES=30

# Реакция, которую бот ставит подтвержденным участникам
DEFAULT_REACTION=👌

# Режим управления действиями администраторов:
#
# soft   - мягкий режим:
#          админ может сразу добавить чат в обработку,
#          owner получает уведомление о действии.
#
# strict - строгий режим:
#          действия админа требуют подтверждения owner.
#          Админ создает заявку, owner подтверждает или отклоняет.
#
# Переключение через Telegram:
# /mode        - показать текущий режим
# /mode_soft   - включить мягкий режим
# /mode_strict - включить строгий режим
#
ADMIN_APPROVAL_MODE=soft
